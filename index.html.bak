<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="theme-color" content="#FF8C00">
<title>王一然工作台</title>
<link rel="manifest" href="manifest.json">
<style>
:root{--y:#FFB347;--yl:#FFF3E0;--ys:#FFCC80;--yd:#FF8C00;--yc:#FFF8F0;--pink:#FF8FB1;--green:#6BCB77;--red:#FF6B6B;--blue:#74B9FF;--purple:#C9A0FF;--t:#3D3028;--tm:#7D6B58;--tl:#B5A590;--bg:#FFF8F0;--card:#FFFFFF;--sb:#F0E8DC;--sh:0 2px 8px rgba(0,0,0,.06);--r:16px;--rs:12px}
*{margin:0;padding:0;box-sizing:border-box;touch-action:manipulation;-webkit-user-select:none;user-select:none}
input,textarea,select{-webkit-user-select:text;user-select:text}
body{font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Segoe UI',sans-serif;background:var(--bg);color:var(--t);line-height:1.5;height:100vh;display:flex;overflow:hidden}
/* 左侧导航 */
.nav{width:220px;background:var(--card);border-right:1px solid var(--sb);display:flex;flex-direction:column;flex-shrink:0;z-index:100;box-shadow:2px 0 16px rgba(0,0,0,.03)}
.nav-h{padding:18px 14px 12px;display:flex;align-items:center;gap:10px;background:linear-gradient(135deg,#FFF3E0,#FFE0B2);border-bottom:1px solid var(--sb)}
.nav-a{width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,var(--y),var(--yd));display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:700;color:#fff;flex-shrink:0;box-shadow:0 3px 10px rgba(255,140,0,.3)}
.nav-n{font-size:16px;font-weight:700;color:var(--yd)}
.nav-s{font-size:11px;color:var(--tm)}
.nav-m{flex:1;padding:6px 10px;overflow-y:auto}
.nav-i{display:flex;align-items:center;gap:10px;padding:11px 12px;border-radius:10px;text-decoration:none;color:var(--tm);font-size:13.5px;font-weight:500;cursor:pointer;margin-bottom:3px;transition:all .18s;position:relative}
.nav-i:hover{background:var(--yl);color:var(--t)}
.nav-i.active{background:linear-gradient(135deg,#FFF3E0,#FFE0B2);color:var(--yd);font-weight:700}
.nav-i.active::before{content:'';position:absolute;left:0;top:50%;transform:translateY(-50%);width:3px;height:20px;background:var(--yd);border-radius:3px}
.nav-icon{font-size:18px;width:22px;text-align:center}
.nav-f{padding:12px 14px;border-top:1px solid var(--sb);display:flex;gap:6px}
.nav-btn{flex:1;padding:8px;border:1.5px solid var(--sb);background:var(--card);border-radius:10px;font-size:11px;color:var(--tm);cursor:pointer;transition:all .15s}
.nav-btn:hover{background:var(--yl);border-color:var(--y)}
.nav-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:90}
/* 主区域 */
.main{flex:1;display:flex;flex-direction:column;overflow:hidden;min-width:0}
.header{height:54px;background:linear-gradient(135deg,#FFF8F0,#FFF3E0);border-bottom:1px solid var(--sb);display:flex;align-items:center;gap:12px;padding:0 18px;flex-shrink:0}
.menu-btn{display:none;width:38px;height:38px;border:none;background:var(--yl);border-radius:10px;font-size:18px;cursor:pointer;color:var(--t)}
.header-t{font-size:18px;font-weight:800;flex:1;color:var(--yd)}
.header-d{font-size:12px;color:var(--tm);background:var(--yl);padding:4px 10px;border-radius:8px}
.page{display:none;flex:1;overflow-y:auto;padding:16px 18px;animation:fadeIn .25s ease}
.page.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
/* 卡片 */
.card{background:var(--card);border-radius:var(--r);padding:18px;margin-bottom:14px;border:1px solid var(--sb);box-shadow:var(--sh)}
.card-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.card-title{font-size:16px;font-weight:800;display:flex;align-items:center;gap:8px}
.card-title .emoji{font-size:20px}
.btn-add{padding:7px 16px;border-radius:20px;border:none;background:linear-gradient(135deg,var(--y),var(--yd));color:#fff;font-size:13px;font-weight:700;cursor:pointer;transition:all .15s;box-shadow:0 2px 8px rgba(255,140,0,.2)}
.btn-add:active{transform:scale(.95)}
.btn-sm{padding:5px 12px;border-radius:14px;border:1.5px solid var(--y);background:#fff;color:var(--yd);font-size:11px;font-weight:600;cursor:pointer;transition:all .15s}
.btn-sm:hover{background:var(--yl)}
/* 筛选 */
.filter-bar{display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap}
.filter-pill{padding:5px 13px;border-radius:14px;background:var(--yc);border:1.5px solid transparent;font-size:12px;color:var(--tm);cursor:pointer;transition:all .15s}
.filter-pill:hover{background:var(--yl)}
.filter-pill.active{background:var(--y);color:#fff;border-color:var(--y);font-weight:700}
/* 任务 */
.task-item{display:flex;align-items:center;gap:10px;padding:11px 14px;border-radius:var(--rs);background:var(--yc);margin-bottom:7px;transition:all .2s;border:1px solid transparent}
.task-item:hover{border-color:var(--y);background:#fff}
.task-item.done{opacity:.45}
.task-item.done .task-text{text-decoration:line-through}
.task-check{width:22px;height:22px;border-radius:50%;border:2.5px solid var(--yd);display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;background:#fff;transition:all .15s}
.task-check:hover{background:var(--yl)}
.task-check.checked{background:linear-gradient(135deg,var(--green),#4CAF50);border-color:var(--green)}
.task-check.checked::after{content:'\2713';color:#fff;font-size:13px;font-weight:bold}
.task-text{font-size:14px;font-weight:500;flex:1}
.task-meta{display:flex;gap:6px;align-items:center;flex-shrink:0}
.task-time{font-size:11px;color:var(--tl)}
.tag-pill{font-size:10px;padding:3px 8px;border-radius:8px;font-weight:700}
.tag-red{background:#FFE0E0;color:#E85555}
.tag-orange{background:#FFF0E0;color:#FF9F43}
.tag-green{background:#D4F5DD;color:#4CAF50}
.tag-blue{background:#D6E4FF;color:#1890FF}
.tag-purple{background:#EDE0FF;color:#8B5CF6}
.task-del{width:28px;height:28px;border:none;background:none;color:var(--tl);font-size:14px;cursor:pointer;opacity:.3;flex-shrink:0;border-radius:8px;display:flex;align-items:center;justify-content:center;transition:all .15s}
.task-del:hover{opacity:1;color:var(--red);background:rgba(255,107,107,.1)}
/* 心情 */
.mood-picker{display:flex;gap:10px;margin-bottom:12px}
.mood-face{width:44px;height:44px;border-radius:50%;border:2.5px solid transparent;background:var(--yc);font-size:22px;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center}
.mood-face:hover{transform:scale(1.15)}
.mood-face.on{border-color:var(--y);background:var(--yl);transform:scale(1.15);box-shadow:0 2px 10px rgba(255,140,0,.2)}
.memo-textarea{width:100%;min-height:80px;border:2px solid #FFE0B2;border-radius:var(--rs);padding:12px;font-size:14px;font-family:inherit;resize:vertical;background:var(--yc);color:var(--t);outline:none;line-height:1.6}
.memo-textarea:focus{border-color:var(--y)}
/* 鼓励语 */
.encourage-box{background:linear-gradient(135deg,#FFF3E0,#FFE0B2);border-radius:var(--r);padding:16px 18px;margin-bottom:14px;text-align:center;border:1px solid var(--y)}
.encourage-text{font-size:18px;font-weight:700;color:var(--yd)}
.encourage-sub{font-size:12px;color:var(--tm);margin-top:4px}
/* 新闻+理财 */
.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px}
@media(max-width:768px){.info-grid{grid-template-columns:1fr}}
.info-card{background:var(--card);border-radius:var(--r);padding:14px;border:1px solid var(--sb);box-shadow:var(--sh)}
.info-card-title{font-size:14px;font-weight:700;margin-bottom:8px;display:flex;align-items:center;gap:6px}
.info-card-text{font-size:13px;color:var(--tm);line-height:1.6}
.info-card-title-sm{font-size:13px;font-weight:700;color:var(--yd);margin-bottom:4px}
/* 运动 */
.sport-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(80px,1fr));gap:8px;margin-bottom:12px}
.sport-item{padding:12px 8px;border-radius:var(--rs);background:var(--yc);border:2px solid transparent;text-align:center;cursor:pointer;transition:all .15s}
.sport-item:hover{border-color:var(--y);background:#fff}
.sport-item.on{background:linear-gradient(135deg,#FFF3E0,#FFE0B2);border-color:var(--yd)}
.sport-emoji{font-size:26px;display:block}
.sport-name{font-size:11px;font-weight:600;margin-top:4px}
.sport-status{font-size:10px;color:var(--green);margin-top:2px}
/* 爆款 */
.hot-item{background:var(--card);border-radius:var(--r);border:1px solid var(--sb);margin-bottom:10px;overflow:hidden;transition:all .15s}
.hot-item:hover{border-color:var(--y);box-shadow:0 3px 12px rgba(255,140,0,.1)}
.hot-cover{height:200px;background:linear-gradient(135deg,#667eea,#764ba2);display:flex;align-items:center;justify-content:center;position:relative;cursor:pointer;overflow:hidden;border-radius:var(--r) var(--r) 0 0}
.hot-cover::before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.05) 30%,rgba(0,0,0,.55) 100%);z-index:1}
.hot-cover::after{content:'';position:absolute;top:20px;left:20px;right:20px;bottom:20px;border:2px solid rgba(255,255,255,.2);border-radius:8px;z-index:1;pointer-events:none}
.hot-cover:hover .hot-play{transform:scale(1.1);box-shadow:0 4px 20px rgba(0,0,0,.25)}
.hot-cover-bg{position:absolute;inset:0;background-size:cover;background-position:center;opacity:.7}
.hot-cover-overlay{position:absolute;bottom:12px;left:14px;right:14px;z-index:2;display:flex;align-items:flex-end;justify-content:space-between;gap:8px}
.hot-cover-title{color:#fff;font-size:13px;font-weight:700;line-height:1.4;text-shadow:0 1px 4px rgba(0,0,0,.6);flex:1;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.hot-cover-duration{background:rgba(0,0,0,.6);color:#fff;font-size:10px;padding:2px 6px;border-radius:4px;flex-shrink:0}
.hot-play{width:50px;height:50px;border-radius:50%;background:rgba(255,255,255,.9);display:flex;align-items:center;justify-content:center;font-size:22px;box-shadow:0 2px 16px rgba(0,0,0,.2);position:relative;z-index:3;transition:all .2s}
/* 视频弹窗 */
.video-modal{position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:500;display:none;flex-direction:column;align-items:center;justify-content:center}
.video-modal.show{display:flex}
.video-modal-close{position:absolute;top:16px;right:16px;width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.2);border:none;color:#fff;font-size:20px;cursor:pointer;z-index:10;display:flex;align-items:center;justify-content:center}
.video-modal-content{width:100%;max-width:420px;background:#000;border-radius:12px;overflow:hidden;position:relative}
.video-modal-content iframe{width:100%;height:560px;border:none}
.video-modal-info{color:#fff;padding:12px 16px;text-align:center}
.video-modal-info .vtitle{font-size:15px;font-weight:700;margin-bottom:4px}
.video-modal-info .vauthor{font-size:12px;opacity:.7}
.video-modal-actions{display:flex;gap:8px;padding:0 16px 16px}
.video-modal-actions .vm-btn{flex:1;padding:10px;border-radius:10px;border:none;font-size:13px;font-weight:700;cursor:pointer}
.vm-btn-light{background:rgba(255,255,255,.15);color:#fff}
.vm-btn-main{background:var(--y);color:#fff}
.hot-rank{position:absolute;top:8px;left:8px;background:rgba(0,0,0,.55);color:var(--y);padding:3px 9px;border-radius:8px;font-size:11px;font-weight:700}
.hot-match{position:absolute;top:8px;right:8px;background:var(--green);color:#fff;padding:3px 9px;border-radius:8px;font-size:10px;font-weight:700}
.hot-body{padding:12px}
.hot-title{font-size:14px;font-weight:700;line-height:1.4;margin-bottom:4px}
.hot-author{font-size:11px;color:var(--tm);margin-bottom:6px}
.hot-stats{font-size:11px;color:var(--tl);margin-bottom:8px}
.hot-style{font-size:10px;color:var(--tm);background:var(--yc);padding:3px 8px;border-radius:6px;display:inline-block;margin-bottom:8px}
.hot-tags{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:8px}
.hot-tag{font-size:10px;background:#FFF0E0;color:var(--yd);padding:2px 7px;border-radius:6px}
.hot-actions{display:flex;gap:6px}
.hot-btn{flex:1;padding:8px;border-radius:10px;border:none;font-size:12px;font-weight:700;cursor:pointer;transition:all .15s}
.hot-btn:active{transform:scale(.95)}
.hot-btn-light{background:var(--yl);color:var(--yd)}
.hot-btn-light:hover{background:#FFE0B2}
.hot-btn-main{background:linear-gradient(135deg,var(--y),var(--yd));color:#fff}
.hot-btn-main:hover{opacity:.9}
.search-box{position:relative;margin-bottom:12px}
.search-icon{position:absolute;left:12px;top:50%;transform:translateY(-50%);font-size:15px}
.search-input{width:100%;padding:10px 14px 10px 36px;border:2px solid #FFE0B2;border-radius:var(--r);font-size:14px;background:#fff;outline:none}
.search-input:focus{border-color:var(--y)}
.update-info{font-size:12px;color:var(--tm);margin-bottom:12px;padding:6px 12px;background:var(--yc);border-radius:10px;display:flex;align-items:center;gap:6px}
/* 灵感 */
.inspire-item{display:flex;align-items:flex-start;gap:10px;padding:11px 14px;border-radius:var(--rs);background:var(--yc);margin-bottom:7px;border-left:3px solid var(--pink)}
.inspire-emoji{font-size:20px;flex-shrink:0}
.inspire-text{font-size:14px;flex:1;line-height:1.5}
.inspire-link{font-size:11px;color:var(--blue);cursor:pointer;word-break:break-all;margin-top:3px;display:block}
.inspire-link:hover{text-decoration:underline}
.inspire-tags{display:flex;gap:4px;flex-wrap:wrap;margin-top:4px}
.inspire-tag{font-size:10px;background:var(--yl);color:var(--yd);padding:2px 8px;border-radius:6px}
/* 复盘 */
.review-item{background:var(--card);border-radius:var(--r);padding:14px;margin-bottom:10px;border:1px solid var(--sb);border-left:4px solid var(--y)}
.review-title{font-size:15px;font-weight:700;margin-bottom:4px}
.review-date{font-size:11px;color:var(--tl);margin-bottom:10px}
.review-metrics{display:flex;gap:8px;margin-bottom:10px}
.review-metric{background:var(--yc);padding:7px 10px;border-radius:8px;text-align:center;min-width:50px}
.review-metric-val{font-size:15px;font-weight:700;color:var(--yd)}
.review-metric-label{font-size:9px;color:var(--tl)}
.review-analysis{background:var(--yc);border-radius:10px;padding:10px;font-size:13px;color:var(--tm);line-height:1.6;margin-bottom:8px}
.review-suggest{background:#E8F5E9;border-radius:10px;padding:10px;font-size:13px;color:var(--t);line-height:1.6}
/* 样品 */
.sample-section{margin-bottom:14px}
.sample-section-title{font-size:14px;font-weight:700;margin-bottom:8px;display:flex;align-items:center;gap:6px;color:var(--yd)}
.sample-section-title .count{font-size:12px;color:var(--tl);font-weight:400}
.sample-item{display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:10px;background:var(--yc);margin-bottom:5px;transition:all .15s;cursor:pointer}
.sample-item:hover{background:#fff;border-color:var(--y)}
.sample-note-btn{width:28px;height:28px;border:none;background:none;color:var(--tm);font-size:13px;cursor:pointer;opacity:.4;flex-shrink:0;border-radius:8px;display:flex;align-items:center;justify-content:center;transition:all .15s}
.sample-note-btn:hover{opacity:1;color:var(--yd);background:var(--yl)}
.sample-dot{width:22px;height:22px;border-radius:50%;border:2.5px solid var(--yd);display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;background:#fff;transition:all .15s}
.sample-dot.done{background:var(--green);border-color:var(--green)}
.sample-dot.done::after{content:'\2713';color:#fff;font-size:12px;font-weight:bold}
.sample-dot.progress{border-style:dashed;border-color:var(--blue)}
.sample-info{flex:1;min-width:0}
.sample-name{font-size:13px;font-weight:600}
.sample-note{font-size:10px;color:var(--tl);margin-top:1px}
.sample-badge{font-size:10px;padding:2px 7px;border-radius:6px;font-weight:600;flex-shrink:0}
.badge-done{background:#D4F5DD;color:#4CAF50}
.badge-repeat{background:#FFF0E0;color:#FF9F43}
.badge-pending{background:#FFE0E0;color:#E85555}
.badge-script{background:#D6E4FF;color:#1890FF}
/* 日历排期 */
.calendar{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-bottom:12px}
.cal-day-header{text-align:center;font-size:11px;font-weight:700;color:var(--tl);padding:4px}
.cal-day{aspect-ratio:1;border-radius:10px;background:var(--yc);display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;font-size:13px;font-weight:600;position:relative;transition:all .15s;border:2px solid transparent}
.cal-day:hover{background:#fff;border-color:var(--y)}
.cal-day.today{background:linear-gradient(135deg,#FFF3E0,#FFE0B2);border-color:var(--yd);font-weight:800}
.cal-day.other-month{opacity:.3}
.cal-day.has-event::after{content:'';position:absolute;bottom:4px;width:6px;height:6px;border-radius:50%;background:var(--yd)}
.cal-emoji{font-size:10px;position:absolute;top:2px;right:2px}
/* 脚本 */








/* 排期 */
.schedule-item{display:flex;gap:10px;padding:10px 14px;border-radius:10px;background:var(--card);margin-bottom:6px;border:1px solid var(--sb);align-items:center;cursor:pointer;transition:all .15s}
.schedule-item:hover{background:var(--yl)}
.schedule-time{flex-shrink:0;text-align:center;min-width:44px;background:var(--yl);border-radius:8px;padding:6px 4px}
.schedule-time-h{font-size:14px;font-weight:700;color:var(--yd)}
.schedule-time-d{font-size:9px;color:var(--tl)}
.schedule-info{flex:1}
.schedule-title{font-size:14px;font-weight:600}
.schedule-desc{font-size:11px;color:var(--tm)}
.schedule-remind{display:inline-flex;align-items:center;gap:3px;font-size:10px;color:var(--red);background:#FFF0F0;padding:2px 8px;border-radius:8px;margin-top:3px}
.schedule-dot{width:8px;height:8px;border-radius:50%;position:absolute;top:10px;right:10px}
.dot-pending{background:var(--yd)}
.dot-done{background:var(--green)}
.dot-missed{background:var(--red)}
/* 空状态 */
.empty-state{text-align:center;padding:30px;color:var(--tl)}
.empty-emoji{font-size:36px;margin-bottom:8px}
.empty-text{font-size:13px}
/* FAB */
.fab-btn{position:fixed;bottom:22px;right:22px;width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,var(--y),var(--yd));border:none;box-shadow:0 4px 18px rgba(255,140,0,.35);font-size:24px;color:#fff;cursor:pointer;z-index:50;display:flex;align-items:center;justify-content:center;transition:all .15s}
.fab-btn:active{transform:scale(.88)}
/* 模态框 */
.modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:200;display:none;align-items:flex-end;justify-content:center}
.modal-bg.show{display:flex}
.modal-box{background:#fff;width:100%;max-width:480px;border-radius:22px 22px 0 0;padding:20px;max-height:88vh;overflow-y:auto;animation:slideUp .25s ease}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
.modal-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.modal-title{font-size:18px;font-weight:800}
.modal-x{width:30px;height:30px;border:none;background:var(--yl);border-radius:50%;font-size:16px;cursor:pointer;color:var(--tm);display:flex;align-items:center;justify-content:center;transition:all .15s}
.modal-x:active{background:var(--y)}
.form-line{margin-bottom:12px}
.form-label{font-size:12px;font-weight:700;color:var(--t);margin-bottom:4px;display:block}
.form-input{width:100%;padding:10px 14px;border:2px solid #FFE0B2;border-radius:10px;font-size:14px;font-family:inherit;background:var(--yc);color:var(--t);outline:none}
.form-input:focus{border-color:var(--y)}
.textarea{resize:vertical;min-height:80px;line-height:1.5}
.form-row{display:flex;gap:10px}
.form-row .form-line{flex:1}
.form-row-4{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.btn-confirm{width:100%;padding:13px;background:linear-gradient(135deg,var(--y),var(--yd));border:none;border-radius:12px;color:#fff;font-size:15px;font-weight:800;cursor:pointer;margin-top:6px;transition:all .15s;box-shadow:0 3px 12px rgba(255,140,0,.25)}
.btn-confirm:active{opacity:.85;transform:scale(.97)}
.btn-outline{width:100%;padding:11px;background:#fff;border:2px solid var(--y);border-radius:12px;color:var(--yd);font-size:14px;font-weight:700;cursor:pointer;margin-top:6px;transition:all .15s}
.btn-outline:active{background:var(--yl)}

/* Toast */
.toast{position:fixed;bottom:90px;left:50%;transform:translateX(-50%);background:rgba(61,48,40,.9);color:#fff;padding:9px 20px;border-radius:20px;font-size:13px;z-index:300;opacity:0;pointer-events:none;transition:all .25s}
.toast.show{opacity:1;transform:translateX(-50%) translateY(-8px)}
@media(max-width:768px){.nav{position:fixed;left:0;top:0;bottom:0;transform:translateX(-100%);transition:transform .25s;box-shadow:2px 0 20px rgba(0,0,0,.1)}.nav.open{transform:translateX(0)}.nav-overlay.show{display:block}.menu-btn{display:flex;align-items:center;justify-content:center}.page{padding:12px}.fab-btn{bottom:18px;right:18px}}
</style>
</head>
<body>

<aside class="nav" id="navSidebar">
  <div class="nav-h">
    <div class="nav-a">然</div>
    <div><div class="nav-n">王一然</div><div class="nav-s">创作工作台 · ENTP</div></div>
  </div>
  <nav class="nav-m">
    <a class="nav-i active" data-page="home" onclick="goPage('home')"><span class="nav-icon">🏠</span>主页</a>
    <a class="nav-i" data-page="tasks" onclick="goPage('tasks')"><span class="nav-icon">📋</span>每日计划</a>
    <a class="nav-i" data-page="inspire" onclick="goPage('inspire')"><span class="nav-icon">💡</span>选题灵感</a>
    <a class="nav-i" data-page="hot" onclick="goPage('hot')"><span class="nav-icon">🔥</span>爆款热点</a>
        <a class="nav-i" data-page="review" onclick="goPage('review')"><span class="nav-icon">📊</span>内容复盘</a>
    <a class="nav-i" data-page="samples" onclick="goPage('samples')"><span class="nav-icon">📦</span>样品清单</a>
    <a class="nav-i" data-page="schedule" onclick="goPage('schedule')"><span class="nav-icon">📅</span>发布排期</a>
    <a class="nav-i" data-page="sport" onclick="goPage('sport')"><span class="nav-icon">🏃</span>每日运动</a>
    <a class="nav-i" data-page="memo" onclick="goPage('memo')"><span class="nav-icon">📝</span>备忘录</a>
  </nav>
  <div class="nav-f">
    <button class="nav-btn" onclick="exportData()">📤 导出</button>
    <button class="nav-btn" onclick="document.getElementById('importFile').click()">📥 导入</button>
    <input type="file" id="importFile" style="display:none" accept=".json" onchange="importData(event)">
  </div>
</aside>
<div class="nav-overlay" id="navOverlay" onclick="toggleNav()"></div>

<main class="main">
  <header class="header">
    <button class="menu-btn" onclick="toggleNav()">☰</button>
    <div class="header-t" id="headerTitle">主页</div>
    <div class="header-d" id="headerDate"></div>
  </header>

  <!-- 主页 -->
  <div class="page active" id="page-home">
    <div class="encourage-box"><div class="encourage-text" id="encourageText">✨</div><div class="encourage-sub" id="encourageDate"></div></div>
    <div class="info-grid">
      <div class="info-card">
        <div class="info-card-title">📰 今日热点</div>
        <div class="info-card-text" id="newsContent">加载中...</div>
      </div>
      <div class="info-card">
        <div class="info-card-title">📈 投资小白课堂</div>
        <div class="info-card-title-sm" id="investTitle"></div>
        <div class="info-card-text" id="investContent">加载中...</div>
      </div>
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title"><span class="emoji">😊</span>今日状态</h2></div>
      <div class="mood-picker" id="moodPicker">
        <button class="mood-face" data-m="😎" onclick="setMood('😎')">😎</button>
        <button class="mood-face" data-m="😊" onclick="setMood('😊')">😊</button>
        <button class="mood-face" data-m="😐" onclick="setMood('😐')">😐</button>
        <button class="mood-face" data-m="😴" onclick="setMood('😴')">😴</button>
        <button class="mood-face" data-m="😤" onclick="setMood('😤')">😤</button>
        <button class="mood-face" data-m="🔥" onclick="setMood('🔥')">🔥</button>
      </div>
      <textarea class="memo-textarea" id="statusNote" placeholder="记录今天的心情、想法、进度..." onblur="saveStatusNote()"></textarea>
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title"><span class="emoji">📋</span>今日待办速览</h2></div>
      <div id="homeTaskPreview"></div>
    </div>
  </div>

  <!-- 每日计划 -->
  <div class="page" id="page-tasks">
    <div class="card">
      <div class="card-head"><h2 class="card-title"><span class="emoji">📋</span>每日任务</h2><button class="btn-add" onclick="openModal('taskModal')">+ 添加</button></div>
      <div class="filter-bar">
        <button class="filter-pill active" onclick="filterTasks('all',this)">全部</button>
        <button class="filter-pill" onclick="filterTasks('pending',this)">未完成</button>
        <button class="filter-pill" onclick="filterTasks('done',this)">已完成</button>
      </div>
      <div id="taskList"></div>
    </div>
  </div>

  <!-- 选题灵感 -->
  <div class="page" id="page-inspire">
    <div class="card">
      <div class="card-head"><h2 class="card-title"><span class="emoji">💡</span>灵感记录</h2><button class="btn-add" onclick="openModal('inspirationModal')">+ 记录</button></div>
      <div id="inspirationList"></div>
    </div>
  </div>

  <!-- 爆款热点 -->
  <div class="page" id="page-hot">
    <div class="card">
      <div class="card-head"><h2 class="card-title"><span class="emoji">🔥</span>爆款热点视频</h2><button class="btn-add" onclick="refreshHot()">🔄 刷新</button></div>
      <div class="search-box"><span class="search-icon">🔍</span><input class="search-input" id="hotSearchInput" placeholder="搜索关键词..." onkeyup="searchHot()"></div>
      <div class="filter-bar">
        <button class="filter-pill active" onclick="filterHot('all',this)">全部</button>
        <button class="filter-pill" onclick="filterHot('好物',this)">好物</button>
        <button class="filter-pill" onclick="filterHot('穿搭',this)">穿搭</button>
        <button class="filter-pill" onclick="filterHot('生活',this)">生活</button>
        <button class="filter-pill" onclick="filterHot('成长',this)">成长</button>
        <button class="filter-pill" onclick="filterHot('搞钱',this)">搞钱</button>
      </div>
      <div class="update-info" id="hotUpdateTime">🔄 点击刷新获取最新爆款</div>
      <div id="hotVideoList"></div>
    </div>
  </div>

  <!-- 内容复盘 -->
  <div class="page" id="page-review">
    <div class="card">
      <div class="card-head"><h2 class="card-title"><span class="emoji">📊</span>内容复盘</h2><button class="btn-add" onclick="openModal('reviewModal')">+ 添加</button></div>
      <div class="filter-bar">
        <button class="filter-pill active" onclick="filterReview('all',this)">全部</button>
        <button class="filter-pill" onclick="filterReview('week',this)">本周</button>
        <button class="filter-pill" onclick="filterReview('month',this)">本月</button>
      </div>
      <div id="reviewList"></div>
    </div>
  </div>

  <!-- 样品清单 -->
  <div class="page" id="page-samples">
    <div class="card">
      <div class="card-head"><h2 class="card-title"><span class="emoji">📦</span>样品清单</h2><button class="btn-add" onclick="openModal('sampleModal')">+ 添加</button></div>
      <div class="filter-bar">
        <button class="filter-pill active" onclick="filterSample('all',this)">全部</button>
        <button class="filter-pill" onclick="filterSample('published',this)">已发布</button>
        <button class="filter-pill" onclick="filterSample('repeat',this)">可反复拍</button>
        <button class="filter-pill" onclick="filterSample('pending',this)">未完成</button>
      </div>
      <div id="sampleList"></div>
    </div>
  </div>

  <!-- 发布排期 -->
  <div class="page" id="page-schedule">
    <div class="card">
      <div class="card-head"><h2 class="card-title"><span class="emoji">📅</span>发布排期</h2><button class="btn-add" onclick="openModal('scheduleModal')">+ 添加</button></div>
      <div id="calendarView"></div>
      <div id="scheduleList"></div>
    </div>
  </div>

  <!-- 每日运动 -->
  <div class="page" id="page-sport">
    <div class="card">
      <div class="card-head"><h2 class="card-title"><span class="emoji">🏃</span>今日运动</h2><button class="btn-add" onclick="openModal('sportModal')">+ 记录</button></div>
      <div class="sport-grid" id="sportGrid"></div>
      <div id="sportLog"></div>
    </div>
  </div>

  <!-- 备忘录 -->
  <div class="page" id="page-memo">
    <div class="card">
      <div class="card-head"><h2 class="card-title"><span class="emoji">📝</span>备忘录</h2><button class="btn-add" onclick="saveMemo()">💾 保存</button></div>
      <textarea class="memo-textarea" id="memoContent" placeholder="在这里记录 anything..." style="min-height:400px" onblur="saveMemo()"></textarea>
    </div>
  </div>
</main>

<button class="fab-btn" onclick="quickAdd()">+</button>

<!-- 模态框：任务 -->
<div class="modal-bg" id="modal-taskModal"><div class="modal-box">
<div class="modal-top"><div class="modal-title">📋 添加任务</div><button class="modal-x" onclick="closeModal('taskModal')">×</button></div>
<div class="form-line"><label class="form-label">任务内容</label><input class="form-input" id="taskText" placeholder="例如：每天运动60分钟"></div>
<div class="form-row"><div class="form-line"><label class="form-label">优先级</label><select class="form-input" id="taskPriority"><option value="high">🔴 重要</option><option value="medium" selected>🟡 一般</option><option value="low">🟢 不急</option></select></div>
<div class="form-line"><label class="form-label">提醒时间</label><input class="form-input" type="time" id="taskTime"></div></div>
<div style="display:flex;align-items:center;gap:8px;margin-bottom:10px"><input type="checkbox" id="taskDaily" style="width:18px;height:18px"><label style="font-size:13px;font-weight:600">🔄 每日循环任务</label></div>
<button class="btn-confirm" onclick="submitTask()">✅ 添加</button></div></div>

<!-- 模态框：灵感 -->
<div class="modal-bg" id="modal-inspirationModal"><div class="modal-box">
<div class="modal-top"><div class="modal-title">💡 记录灵感</div><button class="modal-x" onclick="closeModal('inspirationModal')">×</button></div>
<div class="form-line"><label class="form-label">灵感内容</label><textarea class="form-input textarea" id="inspirationText" placeholder="记录想法、创意、拍摄灵感..."></textarea></div>
<div class="form-line"><label class="form-label">🔗 抖音链接（可选，保存后可点击打开）</label><input class="form-input" id="inspirationLink" placeholder="粘贴抖音视频链接"></div>
<div class="form-line"><label class="form-label">标签（逗号分隔）</label><input class="form-input" id="inspirationTags" placeholder="例如：拍摄灵感, 好物推荐"></div>
<button class="btn-confirm" onclick="submitInspiration()">💡 保存</button></div></div>


<!-- 模态框：编辑样品 -->
<div class="modal-bg" id="modal-editSampleModal"><div class="modal-box">
<div class="modal-top"><div class="modal-title">📦 编辑样品</div><button class="modal-x" onclick="closeModal('editSampleModal')">×</button></div>
<input type="hidden" id="editSampleId">
<div class="form-line"><label class="form-label">样品名称</label><input class="form-input" id="editSampleName" readonly style="background:#f5f5f5;color:#999"></div>
<div class="form-line"><label class="form-label">分类</label><select class="form-input" id="editSampleCat"><option value="pending">📝 未完成</option><option value="repeat">🔄 可反复拍</option><option value="published">✅ 已发布</option></select></div>
<div class="form-line"><label class="form-label">📝 拍摄备注 / 产品要求</label><textarea class="form-input textarea" id="editSampleNote" placeholder="品牌方要求、拍摄注意事项、产品特点、稿费信息..."></textarea></div>
<div style="display:flex;align-items:center;gap:8px;margin-bottom:10px"><input type="checkbox" id="editSampleHasScript" style="width:18px;height:18px"><label style="font-size:13px;font-weight:600">✅ 已有脚本</label></div>
<button class="btn-confirm" onclick="saveSampleEdit()">💾 保存</button></div></div>
<!-- 模态框：样品 -->
<div class="modal-bg" id="modal-sampleModal"><div class="modal-box">
<div class="modal-top"><div class="modal-title">📦 添加样品</div><button class="modal-x" onclick="closeModal('sampleModal')">×</button></div>
<div class="form-line"><label class="form-label">样品名称</label><input class="form-input" id="sampleName" placeholder="例如：冷雾直板夹"></div>
<div class="form-line"><label class="form-label">分类</label><select class="form-input" id="sampleCat"><option value="pending">未完成</option><option value="published">已发布</option><option value="repeat">可反复拍</option></select></div>
<div class="form-line"><label class="form-label">备注</label><input class="form-input" id="sampleNote" placeholder="品牌方、进度、脚本状态..."></div>
<div style="display:flex;align-items:center;gap:8px;margin-bottom:10px"><input type="checkbox" id="sampleHasScript" style="width:18px;height:18px"><label style="font-size:13px;font-weight:600">✅ 已有脚本</label></div>
<button class="btn-confirm" onclick="submitSample()">✅ 添加</button></div></div>

<!-- 模态框：排期 -->
<div class="modal-bg" id="modal-scheduleModal"><div class="modal-box">
<div class="modal-top"><div class="modal-title">📅 添加排期</div><button class="modal-x" onclick="closeModal('scheduleModal')">×</button></div>
<div class="form-line"><label class="form-label">标题</label><input class="form-input" id="scheduleTitle" placeholder="例如：发布护发好物合集"></div>
<div class="form-line"><label class="form-label">描述</label><input class="form-input" id="scheduleDesc" placeholder="平台、备注..."></div>
<div class="form-row"><div class="form-line"><label class="form-label">日期</label><input class="form-input" type="date" id="scheduleDate"></div>
<div class="form-line"><label class="form-label">时间</label><input class="form-input" type="time" id="scheduleTime" value="18:00"></div></div>
<div class="form-line"><label class="form-label">标记图标</label><select class="form-input" id="scheduleEmoji"><option value="📹">📹 拍摄</option><option value="✂️">✂️ 剪辑</option><option value="📤">📤 发布</option><option value="💬">💬 直播</option><option value="📦">📦 收样</option><option value="🎯">🎯 重要</option><option value="⭐">⭐ 重点</option><option value="💡">💡 创意</option></select></div>
<div style="display:flex;align-items:center;gap:8px;margin-bottom:10px"><input type="checkbox" id="scheduleReminder" checked style="width:18px;height:18px"><label style="font-size:13px;font-weight:600">🔔 开启提醒</label></div>
<button class="btn-confirm" onclick="submitSchedule()">✅ 添加</button></div></div>

<!-- 模态框：复盘 -->
<div class="modal-bg" id="modal-reviewModal"><div class="modal-box">
<div class="modal-top"><div class="modal-title">📊 添加复盘</div><button class="modal-x" onclick="closeModal('reviewModal')">×</button></div>
<div class="form-line"><label class="form-label">内容标题</label><input class="form-input" id="reviewTitle" placeholder="例如：冷雾直板夹测评"></div>
<div class="form-line"><label class="form-label">🔗 视频链接</label><input class="form-input" id="reviewLink" placeholder="粘贴视频链接，用于分析优化"></div>
<div class="form-line"><label class="form-label">日期</label><input class="form-input" type="date" id="reviewDate"></div>
<div class="form-row-4"><div class="form-line"><label class="form-label">播放</label><input class="form-input" type="number" id="reviewPlays" placeholder="0"></div>
<div class="form-line"><label class="form-label">点赞</label><input class="form-input" type="number" id="reviewLikes" placeholder="0"></div>
<div class="form-line"><label class="form-label">评论</label><input class="form-input" type="number" id="reviewComments" placeholder="0"></div>
<div class="form-line"><label class="form-label">分享</label><input class="form-input" type="number" id="reviewShares" placeholder="0"></div></div>
<div class="form-line"><label class="form-label">数据分析</label><textarea class="form-input textarea" id="reviewAnalysis" placeholder="哪些做得好？哪些需要改进？"></textarea></div>
<div class="form-line"><label class="form-label">下次优化建议</label><textarea class="form-input textarea" id="reviewSuggestions" placeholder="具体可行的改进方案..."></textarea></div>
<button class="btn-confirm" onclick="submitReview()">✅ 添加</button></div></div>


<!-- 模态框：运动 -->
<div class="modal-bg" id="modal-sportModal"><div class="modal-box">
<div class="modal-top"><div class="modal-title">🏃 记录运动</div><button class="modal-x" onclick="closeModal('sportModal')">×</button></div>
<div class="form-line"><label class="form-label">运动类型</label><select class="form-input" id="sportType"><option value="跑步">🏃 跑步</option><option value="跳绳">🪢 跳绳</option><option value="瑜伽">🧘 瑜伽</option><option value="健身">🏋️ 健身</option><option value="游泳">🏊 游泳</option><option value="骑行">🚴 骑行</option><option value="散步">🚶 散步</option><option value="跳舞">💃 跳舞</option><option value="普拉提">🤸 普拉提</option><option value="HIIT">⚡ HIIT</option><option value="拉伸">🧘‍♀️ 拉伸</option><option value="其他">✨ 其他</option></select></div>
<div class="form-line"><label class="form-label">时长（分钟）</label><input class="form-input" type="number" id="sportDuration" placeholder="60" value="60"></div>
<div class="form-line"><label class="form-label">感受</label><select class="form-input" id="sportFeeling"><option value="great">🔥 超棒</option><option value="good">😊 不错</option><option value="ok">😐 还行</option><option value="tired">😴 累</option></select></div>
<div class="form-line"><label class="form-label">备注</label><input class="form-input" id="sportNote" placeholder="想说什么..."></div>
<button class="btn-confirm" onclick="submitSport()">✅ 记录</button></div></div>

<script>
// ==================== 数据层 ====================
const STORAGE = 'wyr_v6';
let D = (() => { try { return JSON.parse(localStorage.getItem(STORAGE)) || def(); } catch { return def(); } })();
function def() { return {
  mood:'', note:'', memo:'',
  tasks:[
    {id:uid(),text:'每天运动60分钟',done:false,priority:'high',time:'07:00',daily:true},
    {id:uid(),text:'刷抖音收集好物/种草素材',done:false,priority:'medium',time:'10:00',daily:true},
    {id:uid(),text:'整理爆款灵感笔记',done:false,priority:'medium',time:'12:00',daily:true},
    {id:uid(),text:'拍摄好物测评/种草视频',done:false,priority:'high',time:'14:00',daily:true},
    {id:uid(),text:'剪辑+发布一条视频',done:false,priority:'high',time:'18:00',daily:true},
    {id:uid(),text:'复盘当日发布数据',done:false,priority:'medium',time:'21:00',daily:true},
    {id:uid(),text:'规划明天的选题方向',done:false,priority:'low',time:'22:00',daily:true},
  ],
  samples:[
    // 已发布 25个
    {id:uid(),name:'遮阳帽',cat:'published',note:'',hasScript:false},
    {id:uid(),name:'袜子',cat:'published',note:'',hasScript:false},
    {id:uid(),name:'乐程式直板夹PRO',cat:'published',note:'',hasScript:false},
    {id:uid(),name:'安辛康面膜',cat:'published',note:'',hasScript:false},
    {id:uid(),name:'安辛康洗面奶',cat:'published',note:'',hasScript:false},
    {id:uid(),name:'金稻直发梳经典款',cat:'published',note:'',hasScript:false},
    {id:uid(),name:'珂拉琪眼线液笔',cat:'published',note:'',hasScript:false},
    {id:uid(),name:'牛仔短裤',cat:'published',note:'',hasScript:false},
    {id:uid(),name:'假睫毛',cat:'published',note:'',hasScript:false},
    {id:uid(),name:'艾诗摩尔直板夹',cat:'published',note:'',hasScript:false},
    {id:uid(),name:'一只柚猫眼一步胶',cat:'published',note:'',hasScript:false},
    {id:uid(),name:'三穿高跟鞋',cat:'published',note:'',hasScript:false},
    {id:uid(),name:'萌牙怪兽',cat:'published',note:'',hasScript:false},
    {id:uid(),name:'一只柚云感胶',cat:'published',note:'',hasScript:false},
    {id:uid(),name:'安辛康修护霜',cat:'published',note:'',hasScript:false},
    {id:uid(),name:'品存F8Max头戴式耳机',cat:'published',note:'',hasScript:false},
    {id:uid(),name:'月儿弯弯洁牙器',cat:'published',note:'600稿费/2条',hasScript:false},
    {id:uid(),name:'图拉斯小贝壳充电宝',cat:'published',note:'',hasScript:false},

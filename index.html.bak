function uid(){return Date.now().toString(36)+Math.random().toString(36).substr(2,6)}
function save(){localStorage.setItem(STORAGE,JSON.stringify(D))}

// ==================== 全局状态 ====================
let curPage='home',curTaskFilter='all',curHotFilter='all',curSampleFilter='all',curReviewFilter='all';

// ==================== 初始化 ====================
document.addEventListener('DOMContentLoaded',()=>{
  initDate();
  renderAll();
  loadEncourage();
  loadNews();
  loadInvest();
  refreshHot();
  checkDailyReset();
  setInterval(checkDailyReset,60000);
  setInterval(autoRefreshHot,3600000);
  setInterval(loadEncourage,1800000);
  if('serviceWorker' in navigator){
    navigator.serviceWorker.register('./sw.js?v=6').catch(()=>{});
  }
});

function initDate(){
  let d=new Date(),w=['日','一','二','三','四','五','六'];
  document.getElementById('headerDate').textContent=d.getFullYear()+'年'+(d.getMonth()+1)+'月'+d.getDate()+'日 星期'+w[d.getDay()];
}

// ==================== 导航 ====================
function toggleNav(){
  document.getElementById('navSidebar').classList.toggle('open');
  document.getElementById('navOverlay').classList.toggle('show');
}
function goPage(p){
  curPage=p;
  document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));
  let t=document.getElementById('page-'+p);if(t)t.classList.add('active');
  document.querySelectorAll('.nav-i').forEach(x=>x.classList.remove('active'));
  let n=document.querySelector('[data-page="'+p+'"]');if(n)n.classList.add('active');
  let titles={home:'主页',tasks:'每日计划',inspire:'选题灵感',hot:'爆款热点',review:'内容复盘',samples:'样品清单',schedule:'发布排期',sport:'每日运动',memo:'备忘录'};
  document.getElementById('headerTitle').textContent=titles[p]||p;
  renderPage(p);
  if(window.innerWidth<=768)toggleNav();
}
function renderPage(p){
  switch(p){
    case 'home':renderHome();break;
    case 'tasks':renderTasks();break;
    case 'hot':renderHot();break;
    case 'review':renderReviews();break;
    case 'inspire':renderInspirations();break;
        case 'samples':renderSamples();break;
    case 'schedule':renderCalendar();renderScheduleList();break;
    case 'sport':renderSport();break;
    case 'memo':renderMemo();break;
  }
}
function renderAll(){renderHome();}

// ==================== 主页 ====================
async function loadEncourage(){
  try{let r=await fetch('/api/encourage');if(r.ok){let d=await r.json();document.getElementById('encourageText').textContent=d.text;document.getElementById('encourageDate').textContent=d.date;return}}
  catch(e){}
  let tips=['今天也要加油呀 ✨','慢慢来比较快 🌱','你比想象中更厉害 💪','今天也是闪闪发光的一天 ⭐','不要内耗，干就完了！⚡'];
  document.getElementById('encourageText').textContent=tips[Math.floor(Math.random()*tips.length)];
  document.getElementById('encourageDate').textContent=new Date().toLocaleDateString('zh-CN');
}

async function loadNews(){
  let news=[
    '🔥 今日消费热点：夏日清凉好物搜索量上涨230%',
    '📱 抖音618好物节预热，美妆个护品类流量激增',
    '👗 多巴胺穿搭持续火爆，相关话题播放量破50亿',
    '💄 护发品类内容互动率环比增长45%',
    '🎬 真实测评类内容完播率高于种草类20%',
    '🛒 直播带货新规：达人需提前报备合作品牌',
  ];
  document.getElementById('newsContent').textContent=news[Math.floor(Math.random()*news.length)];
}

async function loadInvest(){
  try{let r=await fetch('/api/invest');if(r.ok){let d=await r.json();document.getElementById('investTitle').textContent=d.title;document.getElementById('investContent').textContent=d.content;return}}
  catch(e){}
  document.getElementById('investTitle').textContent='什么是定投？';
  document.getElementById('investContent').textContent='定期定额投资，每月固定买入。不管涨跌都买，长期平摊成本。巴菲特推荐普通人定投指数基金。新手建议从每月500-1000元开始。';
}

function renderHome(){
  document.querySelectorAll('#moodPicker .mood-face').forEach(b=>b.classList.toggle('on',b.dataset.m===D.mood));
  document.getElementById('statusNote').value=D.note||'';
  // 待办速览
  let tasks=D.tasks.filter(t=>!t.done).slice(0,5);
  let el=document.getElementById('homeTaskPreview');
  el.innerHTML=tasks.length?tasks.map(t=>'<div class="task-item" onclick="goPage(\'tasks\')" style="cursor:pointer"><div class="task-check"></div><div class="task-text">'+esc(t.text)+'</div><span class="tag-pill '+(t.priority==='high'?'tag-red':t.priority==='medium'?'tag-orange':'tag-green')+'">'+(t.priority==='high'?'重要':t.priority==='medium'?'一般':'不急')+'</span></div>').join(''):'<div class="empty-state"><div class="empty-emoji">✅</div><div class="empty-text">全部完成！太棒了~</div></div>';
}

// ==================== 任务 ====================
function taskItem(t){
  let pm={high:'tag-red',medium:'tag-orange',low:'tag-green'},pl={high:'重要',medium:'一般',low:'不急'};
  return '<div class="task-item '+(t.done?'done':'')+'"><div class="task-check '+(t.done?'checked':'')+'" onclick="toggleTask(\''+t.id+'\')"></div><div class="task-text">'+esc(t.text)+'</div><div class="task-meta">'+(t.time?'<span class="task-time">⏰ '+t.time+'</span>':'')+'<span class="tag-pill '+pm[t.priority]+'">'+pl[t.priority]+'</span>'+(t.daily?'<span style="font-size:10px;color:var(--y)">🔄</span>':'')+'</div><button class="task-del" onclick="deleteTask(\''+t.id+'\')">🗑</button></div>';
}
function renderTasks(){
  let el=document.getElementById('taskList'),tasks=D.tasks;
  if(curTaskFilter==='pending')tasks=tasks.filter(t=>!t.done);
  if(curTaskFilter==='done')tasks=tasks.filter(t=>t.done);
  tasks=[...tasks].sort((a,b)=>a.done!==b.done?a.done?1:-1:0);
  el.innerHTML=tasks.length?tasks.map(t=>taskItem(t)).join(''):'<div class="empty-state"><div class="empty-emoji">✅</div><div class="empty-text">没有任务，点击右上角添加</div></div>';
  if(curPage==='home')renderHome();
}
function toggleTask(id){let t=D.tasks.find(x=>x.id===id);if(t){t.done=!t.done;save();renderTasks()}}
function deleteTask(id){if(!confirm('确定删除？'))return;D.tasks=D.tasks.filter(t=>t.id!==id);save();renderTasks()}
function filterTasks(f,btn){curTaskFilter=f;document.querySelectorAll('#page-tasks .filter-pill').forEach(c=>c.classList.remove('active'));if(btn)btn.classList.add('active');renderTasks()}
function setMood(m){D.mood=D.mood===m?'':m;save();document.querySelectorAll('#moodPicker .mood-face').forEach(b=>b.classList.toggle('on',b.dataset.m===D.mood))}
function saveStatusNote(){D.note=document.getElementById('statusNote').value;save()}
function submitTask(){
  let t=document.getElementById('taskText').value;if(!t.trim())return toast('请输入内容');
  D.tasks.push({id:uid(),text:t.trim(),done:false,priority:document.getElementById('taskPriority').value,time:document.getElementById('taskTime').value,daily:document.getElementById('taskDaily').checked});
  save();renderTasks();document.getElementById('taskText').value='';document.getElementById('taskTime').value='';document.getElementById('taskDaily').checked=false;closeModal('taskModal');toast('✅ 已添加');
}

// ==================== 爆款 ====================
function hotVideoCoverBg(tags){
  var colors={'好物':['#FF6B6B','#FFE0B2'],'穿搭':['#A18CD1','#FFD1FF'],'护发':['#FF9A9E','#FAD0C4'],'生活':['#F6D365','#FDA085'],'成长':['#84FAB0','#8FD3F4'],'搞钱':['#FCCB90','#D57EEB'],'测评':['#667eea','#764ba2'],'种草':['#FF6B6B','#FECFEF'],'女生':['#E2B0FF','#9F44FF'],'职场':['#FFECD2','#FCB69F'],'vlog':['#96FBC4','#F9F586'],'副业':['#F6D365','#FDA085'],'心理':['#A1C4FD','#C2E9FB'],'治愈':['#FF9A9E','#FAD0C4'],'情绪':['#C9A0FF','#E2B0FF'],'理财':['#FCCB90','#D57EEB']};
  var t=(tags||[])[0]||'好物';var c=colors[t]||['#667eea','#764ba2'];
  return 'linear-gradient(135deg,'+c[0]+','+c[1]+')';
}
function hotItem(v,i){
  var tagsHtml=(v.tags||[]).map(function(t){return '<span class="hot-tag">'+esc(t)+'</span>';}).join('');
  var bg=hotVideoCoverBg(v.tags);
  var vid=v.videoUrl||'';
  var dur=['00:18','00:22','00:15','00:25','00:20','00:16','00:19','00:21','00:17','00:23'][i%10];
  var idx=i;
  return '<div class="hot-item"><div class="hot-cover" onclick="openVideoModal(\''+escAttr(vid)+'\',\''+escAttr(v.title)+'\',\''+escAttr(v.author)+'\')" style="background:'+bg+'"><div class="hot-play">▶️</div><div class="hot-rank">TOP '+(i+1)+'</div>'+(v.match?'<div class="hot-match">🎯 '+v.match+'</div>':'')+'<div class="hot-cover-overlay"><div class="hot-cover-title">'+esc(v.title)+'</div><div class="hot-cover-duration">'+dur+'</div></div></div><div class="hot-body"><div class="hot-author">@'+esc(v.author)+' · '+esc(v.tag||'热门')+'</div><div class="hot-stats">👍 '+fmt(v.likes)+' &nbsp;💬 '+fmt(v.comments)+' &nbsp;🔗 '+fmt(v.shares)+'</div><div class="hot-tags">'+tagsHtml+'</div><div class="hot-style">🎬 '+esc(v.style)+'</div><div class="hot-actions"><button class="hot-btn hot-btn-main" onclick="saveInspire(\''+escAttr(v.title)+'\',\''+escAttr(vid)+'\')">💡 灵感</button><button class="hot-btn hot-btn-light" onclick="openVideoModal(\''+escAttr(vid)+'\',\''+escAttr(v.title)+'\',\''+escAttr(v.author)+'\')">▶️ 观看</button></div></div></div>';
}
function renderHot(){
  let el=document.getElementById('hotVideoList'),vids=D.hotVideos.length?D.hotVideos:[];
  if(!vids.length){el.innerHTML='<div class="empty-state"><div class="empty-emoji">🔄</div><div class="empty-text">点击刷新获取最新爆款</div></div>';return}
  if(curHotFilter!=='all')vids=vids.filter(v=>JSON.stringify(v).includes(curHotFilter));
  el.innerHTML=vids.length?vids.map(function(v,i){return hotItem(v,i);}).join(''):'<div class="empty-state"><div class="empty-emoji">🔍</div><div class="empty-text">没有匹配结果</div></div>';
}
function filterHot(f,btn){curHotFilter=f;document.querySelectorAll('#page-hot .filter-pill').forEach(c=>c.classList.remove('active'));if(btn)btn.classList.add('active');renderHot()}
function searchHot(){
  let q=document.getElementById('hotSearchInput').value.trim().toLowerCase(),el=document.getElementById('hotVideoList'),vids=D.hotVideos.length?D.hotVideos:[];
  if(q)vids=vids.filter(v=>JSON.stringify(v).toLowerCase().includes(q));
  el.innerHTML=vids.length?vids.map(function(v,i){return hotItem(v,i);}).join(''):'<div class="empty-state"><div class="empty-emoji">🔍</div><div class="empty-text">没有匹配结果</div></div>';
}
async function refreshHot(){
  let t=document.getElementById('hotUpdateTime');if(t)t.textContent='⏳ 刷新中...';
  try{let r=await fetch('/api/hot?t='+Date.now());if(r.ok){let d=await r.json();D.hotVideos=d.videos||[];D.hotTime=d.updateTime||''}}
  catch(e){console.log('API error, using cache')}
  save();if(t)t.innerHTML='<span>✅</span> 最近更新：'+(D.hotTime||'--');renderHot();toast('🔥 已更新！');
}
function autoRefreshHot(){let n=new Date();if(n.getHours()===9&&n.getMinutes()<5)refreshHot()}

// ==================== 灵感 ====================
function renderInspirations(){
  let el=document.getElementById('inspirationList');
  el.innerHTML=D.inspirations.length?[...D.inspirations].reverse().map(i=>'<div class="inspire-item"><div class="inspire-emoji">💡</div><div style="flex:1"><div class="inspire-text">'+esc(i.text)+'</div>'+(i.link?'<a class="inspire-link" onclick="openLink(\''+escAttr(i.link)+'\')">🔗 打开抖音视频</a>':'')+'<div class="inspire-tags">'+(i.tags||[]).map(t=>'<span class="inspire-tag">'+esc(t)+'</span>').join('')+'</div><div style="font-size:10px;color:var(--tl);margin-top:4px">'+i.date+'</div></div><button class="task-del" onclick="delInspire(\''+i.id+'\')">🗑</button></div>').join(''):'<div class="empty-state"><div class="empty-emoji">💡</div><div class="empty-text">记录你的灵感吧~支持粘贴抖音链接哦</div></div>';
}
function saveInspire(text,url){D.inspirations.push({id:uid(),text,link:url||'',tags:['来自爆款'],date:new Date().toISOString().slice(0,10)});save();toast('💡 已保存')}
function delInspire(id){if(!confirm('确定删除？'))return;D.inspirations=D.inspirations.filter(i=>i.id!==id);save();renderInspirations()}
function submitInspiration(){
  let t=document.getElementById('inspirationText').value;if(!t.trim())return toast('请输入内容');
  D.inspirations.push({id:uid(),text:t.trim(),link:document.getElementById('inspirationLink').value.trim(),tags:document.getElementById('inspirationTags').value.split(/[,，]/).map(x=>x.trim()).filter(Boolean),date:new Date().toISOString().slice(0,10)});
  save();renderInspirations();document.getElementById('inspirationText').value='';document.getElementById('inspirationLink').value='';document.getElementById('inspirationTags').value='';closeModal('inspirationModal');toast('💡 已记录');
}

// ==================== 复盘 ====================
function renderReviews(){
  let el=document.getElementById('reviewList'),revs=D.reviews;
  if(curReviewFilter==='week')revs=revs.filter(r=>new Date(r.date)>=new Date(Date.now()-7*86400000));
  if(curReviewFilter==='month')revs=revs.filter(r=>new Date(r.date)>=new Date(Date.now()-30*86400000));
  el.innerHTML=revs.length?[...revs].reverse().map(r=>'<div class="review-item"><div class="review-title">'+esc(r.title)+'</div><div class="review-date">📅 '+r.date+(r.link?' · <a style="color:var(--blue);cursor:pointer" onclick="openLink(\''+escAttr(r.link)+'\')">🔗 视频链接</a>':'')+'</div><div class="review-metrics"><div class="review-metric"><div class="review-metric-val">'+fmt(r.plays)+'</div><div class="review-metric-label">播放</div></div><div class="review-metric"><div class="review-metric-val">'+fmt(r.likes)+'</div><div class="review-metric-label">点赞</div></div><div class="review-metric"><div class="review-metric-val">'+r.comments+'</div><div class="review-metric-label">评论</div></div><div class="review-metric"><div class="review-metric-val">'+r.shares+'</div><div class="review-metric-label">分享</div></div></div><div class="review-analysis">📊 分析：'+esc(r.analysis||'暂无')+'</div><div class="review-suggest">💡 建议：'+esc(r.suggestions||'暂无')+'</div><button class="task-del" style="float:right;margin-top:8px" onclick="delReview(\''+r.id+'\')">🗑</button></div>').join(''):'<div class="empty-state"><div class="empty-emoji">📊</div><div class="empty-text">还没有复盘记录</div></div>';
}
function filterReview(f,btn){curReviewFilter=f;document.querySelectorAll('#page-review .filter-pill').forEach(c=>c.classList.remove('active'));if(btn)btn.classList.add('active');renderReviews()}
function delReview(id){if(!confirm('确定删除？'))return;D.reviews=D.reviews.filter(r=>r.id!==id);save();renderReviews()}
function submitReview(){
  let title=document.getElementById('reviewTitle').value;if(!title.trim())return toast('请输入标题');
  let plays=+document.getElementById('reviewPlays').value||0,likes=+document.getElementById('reviewLikes').value||0,comments=+document.getElementById('reviewComments').value||0,shares=+document.getElementById('reviewShares').value||0;
  // AI 分析建议
  let analysis=document.getElementById('reviewAnalysis').value||autoAnalyze(plays,likes,comments,shares);
  let suggestions=document.getElementById('reviewSuggestions').value||autoSuggest(plays,likes,comments);
  D.reviews.push({id:uid(),title:title.trim(),link:document.getElementById('reviewLink').value.trim(),date:document.getElementById('reviewDate').value||new Date().toISOString().slice(0,10),plays,likes,comments,shares,analysis,suggestions});
  save();renderReviews();['reviewTitle','reviewLink','reviewDate','reviewPlays','reviewLikes','reviewComments','reviewShares','reviewAnalysis','reviewSuggestions'].forEach(id=>document.getElementById(id).value='');closeModal('reviewModal');toast('📊 已添加');
}
function autoAnalyze(plays,likes,comments,shares){
  let rate=plays>0?(likes/plays*100).toFixed(1):'0';let engage=plays>0?((likes+comments+shares)/plays*100).toFixed(1):'0';
  return '点赞率：'+rate+'%，互动率：'+engage+'%。'+(parseFloat(rate)>3?'互动数据表现不错！':parseFloat(rate)>1?'互动率中等，可以优化开头留人。':'互动率偏低，建议优化内容吸引力。');
}
function autoSuggest(plays,likes,comments){
  return '1. 开头3秒用痛点或好奇心钩子\n2. 真人出镜增加信任感\n3. 结尾引导点赞+关注+橱窗';
}

// ==================== 样品 ====================
function renderSamples(){
  let el=document.getElementById('sampleList'),samples=D.samples;
  if(curSampleFilter!=='all')samples=samples.filter(s=>s.cat===curSampleFilter);
  let cats={published:{title:'✅ 已发布',badge:'badge-done',label:'已发布',count:0},repeat:{title:'🔄 可反复拍·出单好',badge:'badge-repeat',label:'反复拍',count:0},pending:{title:'📝 未完成',badge:'badge-pending',label:'未完成',count:0}};
  if(curSampleFilter==='all'){
    let html='';
    for(let [key,cat] of Object.entries(cats)){
      let items=samples.filter(s=>s.cat===key);
      cat.count=items.length;
      html+='<div class="sample-section"><div class="sample-section-title">'+cat.title+' <span class="count">('+items.length+'个)</span></div>';
      html+=items.length?items.map(s=>sampleRow(s)).join(''):'<div class="empty-state" style="padding:10px"><div class="empty-text">暂无</div></div>';
      html+='</div>';
    }
    el.innerHTML=html;
  } else {
    el.innerHTML=samples.length?samples.map(s=>sampleRow(s)).join(''):'<div class="empty-state"><div class="empty-emoji">📦</div><div class="empty-text">暂无</div></div>';
  }
}
function sampleRow(s){
  var b=s.cat==='published'?'<span class="sample-badge badge-done">已发布</span>':s.cat==='repeat'?'<span class="sample-badge badge-repeat">反复拍</span>':'<span class="sample-badge badge-pending">未完成</span>';
  var scriptTag=s.hasScript?' <span class="sample-badge badge-script">脚本✅</span>':'';
  var dotClass=s.cat==='published'?'done':s.cat==='repeat'?'progress':'';
  var noteHtml=s.note?'<div class="sample-note">'+esc(s.note)+'</div>':'';
  return '<div class="sample-item" onclick="editSample(\''+s.id+'\')"><div class="sample-dot '+dotClass+'"></div><div class="sample-info"><div class="sample-name">'+esc(s.name)+scriptTag+'</div>'+noteHtml+'</div>'+b+'<button class="sample-note-btn" onclick="event.stopPropagation();quickNoteSample(\''+s.id+'\')" title="添加备注">📝</button><button class="task-del" onclick="event.stopPropagation();delSample(\''+s.id+'\')">🗑</button></div>';
}
function editSample(id){
  var s=D.samples.find(function(x){return x.id===id;});
  if(!s)return;
  document.getElementById('editSampleId').value=s.id;
  document.getElementById('editSampleName').value=s.name;
  document.getElementById('editSampleCat').value=s.cat;
  document.getElementById('editSampleNote').value=s.note||'';
  document.getElementById('editSampleHasScript').checked=s.hasScript||false;
  openModal('editSampleModal');
}
function saveSampleEdit(){
  var id=document.getElementById('editSampleId').value;
  var s=D.samples.find(function(x){return x.id===id;});
  if(!s)return;
  s.cat=document.getElementById('editSampleCat').value;
  s.note=document.getElementById('editSampleNote').value;
  s.hasScript=document.getElementById('editSampleHasScript').checked;
  save();renderSamples();closeModal('editSampleModal');toast('✅ 已保存');
}
function quickNoteSample(id){
  var s=D.samples.find(function(x){return x.id===id;});
  if(!s)return;
  var note=prompt('添加备注 / 拍摄要求：',s.note||'');
  if(note!==null){s.note=note;save();renderSamples();toast('📝 备注已保存');}
}
function delSample(id){if(!confirm('确定删除？'))return;D.samples=D.samples.filter(s=>s.id!==id);save();renderSamples()}
function filterSample(f,btn){curSampleFilter=f;document.querySelectorAll('#page-samples .filter-pill').forEach(c=>c.classList.remove('active'));if(btn)btn.classList.add('active');renderSamples()}
function submitSample(){
  let n=document.getElementById('sampleName').value;if(!n.trim())return toast('请输入名称');
  D.samples.push({id:uid(),name:n.trim(),cat:document.getElementById('sampleCat').value,note:document.getElementById('sampleNote').value,hasScript:document.getElementById('sampleHasScript').checked});
  save();renderSamples();document.getElementById('sampleName').value='';document.getElementById('sampleNote').value='';document.getElementById('sampleHasScript').checked=false;closeModal('sampleModal');toast('📦 已添加');
}

// ==================== 日历排期 ====================
function renderCalendar(){
  let now=new Date(),y=now.getFullYear(),m=now.getMonth(),today=now.getDate();
  let firstDay=new Date(y,m,1).getDay(),daysInMonth=new Date(y,m+1,0).getDate();
  let el=document.getElementById('calendarView');
  let html='<div class="calendar"><div class="cal-day-header">日</div><div class="cal-day-header">一</div><div class="cal-day-header">二</div><div class="cal-day-header">三</div><div class="cal-day-header">四</div><div class="cal-day-header">五</div><div class="cal-day-header">六</div>';
  for(let i=0;i<firstDay;i++)html+='<div class="cal-day other-month"></div>';
  for(let d=1;d<=daysInMonth;d++){
    let ds=y+'-'+String(m+1).padStart(2,'0')+'-'+String(d).padStart(2,'0');
    let events=D.schedules.filter(s=>s.date===ds);
    let cls='cal-day'+(d===today?' today':'');
    let emoji='';
    if(events.length>0){cls+=' has-event';emoji=events[0].emoji||'📅'}
    html+='<div class="'+cls+'" onclick="showDaySchedule(\''+ds+'\')">'+d+(emoji?'<span class="cal-emoji">'+emoji+'</span>':'')+'</div>';
  }
  html+='</div>';
  el.innerHTML=html;
}
function showDaySchedule(ds){
  let events=D.schedules.filter(s=>s.date===ds);
  if(events.length===0){toast('当天没有排期');return}
  let el=document.getElementById('scheduleList');
  el.innerHTML='<div style="margin-bottom:8px;font-weight:700;color:var(--yd)">📅 '+ds+' 排期</div>'+events.map(s=>schRow(s)).join('');
}
function renderScheduleList(){renderCalendar();showDaySchedule(new Date().toISOString().slice(0,10))}
function schRow(s){
  return '<div class="schedule-item" onclick="cycleSchedule(\''+s.id+'\')" style="position:relative"><div class="schedule-time"><div class="schedule-time-h">'+s.time+'</div><div class="schedule-time-d">'+s.date.slice(5)+'</div></div><div class="schedule-info"><div class="schedule-title">'+(s.emoji||'📅')+' '+esc(s.title)+'</div>'+(s.desc?'<div class="schedule-desc">'+esc(s.desc)+'</div>':'')+(s.remind?'<div class="schedule-remind">🔔 提醒</div>':'')+'</div><div class="schedule-dot '+(s.status==='done'?'dot-done':s.status==='missed'?'dot-missed':'dot-pending')+'"></div><button class="task-del" onclick="event.stopPropagation();delSchedule(\''+s.id+'\')">🗑</button></div>';
}
function cycleSchedule(id){let s=D.schedules.find(x=>x.id===id);if(s){let o=['pending','done','missed'];s.status=o[(o.indexOf(s.status)+1)%3];save();renderCalendar();renderScheduleList()}}
function delSchedule(id){if(!confirm('确定删除？'))return;D.schedules=D.schedules.filter(s=>s.id!==id);save();renderCalendar();renderScheduleList()}
function submitSchedule(){
  let t=document.getElementById('scheduleTitle').value,d=document.getElementById('scheduleDate').value;
  if(!t.trim()||!d)return toast('请填写标题和日期');
  D.schedules.push({id:uid(),title:t.trim(),desc:document.getElementById('scheduleDesc').value,date:d,time:document.getElementById('scheduleTime').value||'18:00',emoji:document.getElementById('scheduleEmoji').value,remind:document.getElementById('scheduleReminder').checked,status:'pending'});
  save();renderCalendar();renderScheduleList();document.getElementById('scheduleTitle').value='';document.getElementById('scheduleDesc').value='';closeModal('scheduleModal');toast('📅 已添加');
}

// ==================== 运动 ====================
function renderSport(){
  let sports=['🏃 跑步','🪢 跳绳','🧘 瑜伽','🏋️ 健身','🏊 游泳','🚴 骑行','🚶 散步','💃 跳舞','🤸 普拉提','⚡ HIIT','🧘‍♀️ 拉伸'];
  let today=new Date().toISOString().slice(0,10);
  let todaySports=D.sports.filter(s=>s.date===today);
  let grid=document.getElementById('sportGrid');
  grid.innerHTML=sports.map(sp=>{
    let name=sp.split(' ')[1];let emoji=sp.split(' ')[0];
    let done=todaySports.find(s=>s.type===name);
    return '<div class="sport-item'+(done?' on':'')+'" onclick="quickSport(\''+name+'\')"><span class="sport-emoji">'+emoji+'</span><span class="sport-name">'+name+'</span>'+(done?'<span class="sport-status">✅ '+done.duration+'min</span>':'')+'</div>';
  }).join('');
  // 运动日志
  let log=document.getElementById('sportLog');
  let recent=[...D.sports].reverse().slice(0,10);
  log.innerHTML=recent.length?'<div style="margin-top:12px"><div style="font-weight:700;margin-bottom:8px;color:var(--yd)">📋 最近记录</div>'+recent.map(s=>{
    let feel={great:'🔥超棒',good:'😊不错',ok:'😐还行',tired:'😴累'};
    return '<div style="display:flex;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid var(--sb);font-size:13px"><span style="font-weight:600">'+s.date.slice(5)+'</span> <span>'+s.type+'</span> <span style="color:var(--yd);font-weight:600">'+s.duration+'min</span> <span>'+feel[s.feeling]+'</span>'+(s.note?'<span style="color:var(--tl);font-size:11px">'+esc(s.note)+'</span>':'')+'<button class="task-del" onclick="delSport(\''+s.id+'\')">🗑</button></div>';
  }).join('')+'</div>':'';
}
function quickSport(type){
  document.getElementById('sportType').value=type;
  openModal('sportModal');
}
function submitSport(){
  let type=document.getElementById('sportType').value,dur=+document.getElementById('sportDuration').value||60;
  D.sports.push({id:uid(),type,duration:dur,feeling:document.getElementById('sportFeeling').value,note:document.getElementById('sportNote').value,date:new Date().toISOString().slice(0,10)});
  save();renderSport();closeModal('sportModal');toast('🏃 运动已记录！');
}
function delSport(id){if(!confirm('确定删除？'))return;D.sports=D.sports.filter(s=>s.id!==id);save();renderSport()}

// ==================== 备忘录 ====================
function renderMemo(){document.getElementById('memoContent').value=D.memo||''}
function saveMemo(){D.memo=document.getElementById('memoContent').value;save();toast('💾 已保存')}

// ==================== 模态框 ====================
function openModal(id){document.getElementById('modal-'+id).classList.add('show')}
function closeModal(id){document.getElementById('modal-'+id).classList.remove('show');document.getElementById('extractResult').style.display='none'}

// ==================== 快捷添加 ====================
function quickAdd(){
  let m={home:'taskModal',tasks:'taskModal',inspire:'inspirationModal',hot:'inspirationModal',review:'reviewModal',samples:'sampleModal',schedule:'scheduleModal',sport:'sportModal',memo:'taskModal'};
  openModal(m[curPage]||'taskModal');
}

// ==================== 每日重置 ====================
function checkDailyReset(){
  let today=new Date().toISOString().slice(0,10),last=localStorage.getItem('wyr_reset_v6');
  if(last!==today){D.tasks.forEach(t=>{if(t.daily)t.done=false});save();localStorage.setItem('wyr_reset_v6',today);if(curPage==='tasks'||curPage==='home')renderTasks()}
}

// ==================== 导入导出 ====================
function exportData(){
  let b=new Blob([JSON.stringify(D,null,2)],{type:'application/json'});
  let a=document.createElement('a');a.href=URL.createObjectURL(b);
  a.download='yiran-backup-'+new Date().toISOString().slice(0,10)+'.json';a.click();
  URL.revokeObjectURL(a.href);toast('📤 已导出');
}
function importData(e){
  let f=e.target.files[0];if(!f)return;
  let r=new FileReader();
  r.onload=ev=>{try{let d=JSON.parse(ev.target.result);if(confirm('确认导入？当前数据将被覆盖！')){D=d;save();renderAll();toast('📥 已恢复')}}catch(e){toast('❌ 格式错误')}};
  r.readAsText(f);
}

// ==================== 工具函数 ====================
function fmt(n){return n>=10000?(n/10000).toFixed(1)+'万':n>=1000?(n/1000).toFixed(1)+'k':String(n)}
function esc(s){let d=document.createElement('div');d.textContent=s;return d.innerHTML}
function escAttr(s){return (s||'').replace(/'/g,"\\'").replace(/"/g,'&quot;')}
function openLink(url){if(!url)return toast('暂无链接');window.open(url,'_blank')}
function toast(msg){
  let t=document.getElementById('toast');
  if(!t){t=document.createElement('div');t.id='toast';t.className='toast';document.body.appendChild(t)}
  t.textContent=msg;t.classList.add('show');
  clearTimeout(t._t);t._t=setTimeout(()=>t.classList.remove('show'),2000);
}
// ==================== 视频弹窗 ====================
function openVideoModal(url, title, author){
  var modal=document.getElementById('videoModal');
  modal.dataset.url=url;
  modal.dataset.title=title;
  modal.dataset.author=author;
  document.getElementById('videoModalTitle').textContent=title;
  document.getElementById('videoModalAuthor').textContent='@'+author;
  document.getElementById('videoModalInspireBtn').onclick=function(){saveInspire(title,url);closeVideoModal();};
  
  // 内嵌视频播放（用抖音视频页面iframe）
  var player=document.getElementById('videoPlayer');
  player.innerHTML='<div style="background:#000;display:flex;align-items:center;justify-content:center;height:560px"><div style="text-align:center;color:#fff"><div style="font-size:48px;margin-bottom:16px">🎬</div><div style="font-size:16px;font-weight:700;margin-bottom:8px">'+esc(title).substring(0,30)+'</div><div style="font-size:13px;opacity:.7;margin-bottom:20px">点击下方按钮在抖音中观看完整视频</div><button onclick="window.open(\''+escAttr(url)+'\',\'_blank\')" style="padding:12px 28px;background:linear-gradient(135deg,#FE2C55,#FF4D6A);border:none;border-radius:24px;color:#fff;font-size:15px;font-weight:700;cursor:pointer">📱 在抖音中打开</button></div></div>';
  modal.classList.add('show');
  document.body.style.overflow='hidden';
}
function closeVideoModal(e){
  if(e&&e.target!==document.getElementById('videoModal'))return;
  document.getElementById('videoModal').classList.remove('show');
  document.body.style.overflow='';
  document.getElementById('videoPlayer').innerHTML='';
}
</script>

<!-- 视频播放弹窗 -->
<div class="video-modal" id="videoModal" onclick="closeVideoModal(event)">
  <button class="video-modal-close" onclick="closeVideoModal()">×</button>
  <div class="video-modal-content" onclick="event.stopPropagation()">
    <div id="videoPlayer"></div>
  </div>
  <div class="video-modal-info">
    <div class="vtitle" id="videoModalTitle"></div>
    <div class="vauthor" id="videoModalAuthor"></div>
  </div>
  <div class="video-modal-actions">
    <button class="vm-btn vm-btn-light" onclick="window.open(document.getElementById('videoModal').dataset.url,'_blank')">🔗 在抖音打开</button>
    <button class="vm-btn vm-btn-main" id="videoModalInspireBtn">💡 保存灵感</button>
    
  </div>
</div>
</body>
</html>